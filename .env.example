APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

TAVILY_API_KEY=

# Local development: MySQL
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@127.0.0.1:3306/fridgepilot?charset=utf8mb4

# Production / cloud (set by docker-compose): SQLite
# DATABASE_URL=sqlite:///./data/fridgepilot.db

REQUEST_TIMEOUT_SECONDS=30
MAX_SEARCH_RESULTS=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_FILE=logs/fridgepilotserver.log
